# Database Configuration (For Hugging Face Spaces - using SQLite as default)
DATABASE_URL=sqlite:///./todo_hf_space.db

# JWT Configuration
JWT_SECRET=hf_space_default_secret_for_demo_purposes_only_replace_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# CORS Configuration
CORS_ORIGIN=http://localhost:7860,https://your-hf-space-name.hf.space

# Groq Configuration
GROQ_API_KEY=
